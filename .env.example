# ScaleHouse Connector Configuration Example
# Copy this file to .env and fill in your actual values

# OpenDental MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=opendental_readonly
DB_PASSWORD=your_secure_password
DB_NAME=opendental

# ScaleHouse API Configuration
API_KEY=your_api_key_from_scalehouse
API_URL=https://api.scalehousesystems.com

# Sync Settings
SYNC_INTERVAL_MS=300000  # 5 minutes (300000 ms)

# Notes:
# - Use a READ-ONLY database user for security
# - Never commit the actual .env file to version control
# - The connector only accesses audit tables, not PHI
