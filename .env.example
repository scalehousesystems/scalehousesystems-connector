# ScaleHouse API Configuration
SCALEHOUSE_API_ENDPOINT=https://app.scalehousesystems.com
SCALEHOUSE_API_KEY=your-api-key-here

# Open Dental Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=opendental
DB_PASSWORD=your-password-here
