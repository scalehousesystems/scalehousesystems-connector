# ScaleHouse Connector Configuration Template

# Database Configuration (MySQL OpenDental)
DB_HOST=localhost
DB_PORT=3306
DB_USER=scalehouse_reader
DB_PASSWORD=your_password_here
DB_DATABASE=opendental

# Audit View Name (the view with SELECT-only access)
AUDIT_VIEW=audit_log_view

# ScaleHouse API Configuration
API_KEY=your_api_key_here
API_ENDPOINT=https://api.scalehousesystems.com

# Sync Settings
POLL_INTERVAL_SECONDS=60
BATCH_SIZE=100

# Auto-start connector on application launch
AUTO_START=false

# Security Note:
# The database user should have SELECT-only permissions scoped to:
# - The audit_log_view (or your custom view name)
# - Non-PHI reference tables only
# 
# Example MySQL grants for security:
# CREATE USER 'scalehouse_reader'@'localhost' IDENTIFIED BY 'secure_password';
# GRANT SELECT ON opendental.audit_log_view TO 'scalehouse_reader'@'localhost';
# FLUSH PRIVILEGES;
#
# This ensures least-privilege access and MySQL enforces the restrictions.
